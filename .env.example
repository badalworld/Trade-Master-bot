# ---------------------------------------------------------------------------
# Trade Master - environment configuration
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Binance credentials (OPTIONAL but strongly preferred)
# ---------------------------------------------------------------------------
# Setting these server-side means keys never pass through a browser at all. If they are unset,
# operators can still open a short-lived httpOnly credential session from Settings, which is kept
# in process memory only (requires a single-instance deployment, e.g. Cloud Run --max-instances=1).
# BINANCE_API_KEY="..."
# BINANCE_API_SECRET="..."
# true = Binance Futures Testnet (paper). This is the safe default.
BINANCE_TESTNET="true"

# ---------------------------------------------------------------------------
# Operator authentication (REQUIRED as soon as the Binance keys above are set)
# ---------------------------------------------------------------------------
# Without this, order placement, closes, account reads and engine controls are reachable by anyone
# who can open the deployed URL: the X-TM-Request header is a CSRF guard, not authentication.
# Generate one with:  openssl rand -hex 32
TM_OPERATOR_TOKEN=""
# auto (default) = a signed operator session is required whenever BINANCE_API_KEY/SECRET are set.
# on             = required even when keys are supplied through the browser session flow.
# off            = never required. ONLY safe behind platform auth (Cloud Run IAM/IAP, VPN, an
#                  authenticating reverse proxy) — do not use it on a public URL.
TM_OPERATOR_AUTH="auto"
# Note: with TM_OPERATOR_AUTH=auto and server keys present but TM_OPERATOR_TOKEN empty, every money
# endpoint answers 503 OPERATOR_AUTH_NOT_CONFIGURED. That is deliberate: locked beats anonymous
# order placement. The unattended engine keeps running either way (it is not HTTP-reachable).

# ---------------------------------------------------------------------------
# Risk policy (enforced on the server, on every OPEN request - the UI is not a security boundary)
# ---------------------------------------------------------------------------
# Hard gate: mainnet order placement is refused unless this is explicitly enabled.
TRADE_ALLOW_MAINNET="false"
# Master kill switch: blocks new entries; closing existing positions always stays allowed.
TRADE_HALT="false"
TRADE_MIN_LEVERAGE="10"
TRADE_MAX_LEVERAGE="15"
TRADE_MAX_MARGIN_USDT="25"
TRADE_MAX_NOTIONAL_USDT="500"
TRADE_MAX_OPEN_POSITIONS="5"
# Realized loss (from Binance /fapi/v1/income, current UTC day) that locks new entries.
TRADE_MAX_DAILY_LOSS_USDT="50"
# Symbol restriction. Default = the whole market, discovered fresh each scan (see the universe
# block below). Set a comma-separated list here to restrict BOTH the scanner and the executor to
# those pairs and nothing else.
TRADE_SYMBOL_ALLOWLIST=""
# Reject rather than silently inflate size when LOT_SIZE/MIN_NOTIONAL rounding changes notional.
TRADE_MAX_NOTIONAL_DEVIATION_RATIO="1.5"
TRADE_MIN_STOP_DISTANCE_PCT="0.0005"

# The page drives real orders, so it refuses to be framed by another site (clickjacking a
# START BOT / Close position button is a real path to a real loss). Leave empty for the default
# `frame-ancestors 'none'`. Set a CSP source list only if this app must run inside a shell you
# control, e.g. TM_FRAME_ANCESTORS="https://console.example.com" — read at BUILD time (Next.js bakes
# response headers into the routes manifest), so rebuilding is required for a change to take effect.
TM_FRAME_ANCESTORS=""

# ---------------------------------------------------------------------------
# Universe, volatility band and the chop filter (what the scanner looks at)
# ---------------------------------------------------------------------------
# Stage 1 — rank the whole USDT-M market, most volatile first, from one /ticker/24hr call.
# TRADE_DISCOVERY_ENABLED=false pins the universe to the built-in 12 majors (the old behaviour) and
# restores the same restriction at the execution layer.
TRADE_DISCOVERY_ENABLED="true"
# How many of the most volatile liquid pairs the opportunity board keeps.
TRADE_DISCOVERY_TOP_N="40"
# 24h quote-volume floor in USDT. $50M keeps the board to pairs that can absorb an entry and an exit
# without the order itself moving the price.
TRADE_DISCOVERY_MIN_QUOTE_VOLUME="50000000"
# How long a ranking is reused before the market is ranked again.
TRADE_DISCOVERY_TTL_MS="60000"
# Stage 2 — deep-scan this many pairs per cycle, taken from the top of the board. Used when the
# opportunity list below is disabled; with the list on, its size is TRADE_OPPORTUNITY_MAX instead.
TRADE_SCAN_TOP_N="12"

# --- The opportunity list (stage 2's universe) -----------------------------------------------
# The market scan promotes opportunity assets onto this list; the list is then scanned every cycle
# and the bot trades only from it. A pair leaves when it stops qualifying: it drops off the ranked
# board, the market moves it out of the band above, something more volatile takes its slot, or the
# deep scan refuses it (chop / out of band) on TRADE_OPPORTUNITY_STRIKES consecutive passes.
# Leave this on unless you specifically want the stateless behaviour (a fresh shortlist every cycle).
TRADE_OPPORTUNITY_ENABLED="true"
# How many opportunity assets to keep. Also bounded by the per-cycle budget (TRADE_MAX_OPEN_POSITIONS
# x 4 pairs), because every member is deep-scanned every cycle — that bound is what keeps the scan
# inside the API weight limit. Set TRADE_MAX_OPEN_POSITIONS higher to hold a deeper list.
TRADE_OPPORTUNITY_MAX="20"
# Consecutive failed passes before a pair is taken off the list. 1 = evict on the first bad reading.
TRADE_OPPORTUNITY_STRIKES="2"
# How long a removed pair is barred from being re-promoted, so a failed pair cannot bounce back in.
TRADE_OPPORTUNITY_COOLDOWN_MS="300000"
# Volatility band. Below the floor a pair is quiet/dead (signals are noise, stops die on spread);
# above the ceiling it is violent enough that an ATR-sized stop is a coin flip. Both are skipped and
# reported, never traded.
TRADE_MIN_VOLATILITY_PCT="0.6"
TRADE_MAX_VOLATILITY_PCT="4"
# Chop filter: a pair is refused when price is doing nothing, which requires BOTH readings to agree
# (ADX below the floor AND Kaufman efficiency ratio below the floor). A clean slow trend has a low
# ADX but a high efficiency ratio, and is still traded.
TRADE_CHOP_ADX_FLOOR="20"
TRADE_CHOP_EFFICIENCY_FLOOR="0.3"

# ---------------------------------------------------------------------------
# Server-side guardian engine — protection + ledger that survive a closed tab
# ---------------------------------------------------------------------------
# Off by default on purpose: an unattended loop that can touch money must be an explicit decision,
# never a side effect of a deploy. Without this the app behaves exactly as before (browser-driven).
TRADE_ENGINE_ENABLED="false"
# false => GUARDIAN ONLY: reconciles, re-arms stops, backstops breaches, settles the ledger, and
# NEVER opens a position. Flip to true only after the guardian-only mode has been watched for a while.
TRADE_ENGINE_AUTO_ENTRY="false"
# The same switch exists in the app (Positions tab -> "Autopilot") and is persisted in the ledger, so
# turning unattended entries on or off does not need a redeploy. This env value is the floor: once it
# is true here, the UI cannot turn entries off. Enabling it on MAINNET from the UI additionally
# requires confirm:"ENABLE_AUTOPILOT".
# How often the loop runs (minimum 5000 ms). Each cycle costs API weight, so keep this ≥ 10000 on
# a busy allowlist.
TRADE_ENGINE_INTERVAL_MS="15000"
# Cancel-and-replace protection: verify a live STOP_MARKET exists for every tracked position.
TRADE_ENGINE_ENFORCE_BRACKETS="true"
# How many cycles a confirmed-missing stop is tolerated before the position is closed to cap loss.
# Only *answered* failures count; an unreachable API never triggers a forced close.
TRADE_ENGINE_UNPROTECTED_TOLERANCE="2"
# Server-side sizing for its own entries (all bounded by TRADE_MAX_* above).
TRADE_ENGINE_LEVERAGE="10"
TRADE_ENGINE_BASE_MARGIN="2"
TRADE_ENGINE_COMPOUNDING_PCT="20"
# Directory the durable trade ledger (trade-ledger.json) and the opportunity list are written to.
# Default: <cwd>/.data. It MUST be writable: on a container the app directory is often read-only, in
# which case every write fails and the engine refuses automated entries (see the override below).
# Point this at a mounted volume so positions, compounding and the daily-loss figure survive a restart.
TRADE_DATA_DIR=""
# Accept an in-memory ledger anyway. Off by default: with no writable ledger a restart forgets which
# positions are the engine's, resets the daily-loss breaker to zero, and restarts the compounding
# ladder, so automated entries fail closed. The guardian (protecting existing positions) is never
# blocked. Turn this on only if you have decided that an ephemeral ledger is acceptable.
TRADE_ENGINE_ALLOW_NON_DURABLE_LEDGER="false"
