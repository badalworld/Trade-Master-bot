# ---------------------------------------------------------------------------
# Trade Master - environment configuration
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Binance credentials (OPTIONAL but strongly preferred)
# ---------------------------------------------------------------------------
# Setting these server-side means keys never pass through a browser at all. If they are unset,
# operators can still open a short-lived httpOnly credential session from Settings, which is kept
# in process memory only (requires a single-instance deployment, e.g. Cloud Run --max-instances=1).
# BINANCE_API_KEY="..."
# BINANCE_API_SECRET="..."
# true = Binance Futures Testnet (paper). This is the safe default.
BINANCE_TESTNET="true"

# ---------------------------------------------------------------------------
# Risk policy (enforced on the server, on every OPEN request - the UI is not a security boundary)
# ---------------------------------------------------------------------------
# Hard gate: mainnet order placement is refused unless this is explicitly enabled.
TRADE_ALLOW_MAINNET="false"
# Master kill switch: blocks new entries; closing existing positions always stays allowed.
TRADE_HALT="false"
TRADE_MIN_LEVERAGE="10"
TRADE_MAX_LEVERAGE="15"
TRADE_MAX_MARGIN_USDT="25"
TRADE_MAX_NOTIONAL_USDT="500"
TRADE_MAX_OPEN_POSITIONS="5"
# Realized loss (from Binance /fapi/v1/income, current UTC day) that locks new entries.
TRADE_MAX_DAILY_LOSS_USDT="50"
# Comma-separated. The scanner never proposes a pair the executor would refuse.
TRADE_SYMBOL_ALLOWLIST="BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,DOGEUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,SUIUSDT,LINKUSDT,NEARUSDT,1000PEPEUSDT"
# Reject rather than silently inflate size when LOT_SIZE/MIN_NOTIONAL rounding changes notional.
TRADE_MAX_NOTIONAL_DEVIATION_RATIO="1.5"
TRADE_MIN_STOP_DISTANCE_PCT="0.0005"
